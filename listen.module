[Script]
listen_leap = type=http-response,pattern=^https?://.+listenleap\.com/front-api/user/getUserInfoByUserToken,script-path=https://raw.githubusercontent.com/woshitiancaihhh9/11/refs/heads/main/listen.js,requires-body=true,timeout=10,tag=帮你听懂英语播客

[MITM]
hostname = %APPEND% *.listenleap.com
